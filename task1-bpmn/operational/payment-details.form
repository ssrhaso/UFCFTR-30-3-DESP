{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "ffa1f04"
  },
  "schemaVersion": 19,
  "id": "payment-details",
  "components": [
    {
      "text": "## Pay for your order\n\nOrder **{{orderId}}**. Total: **£{{orderTotal}}**.\n\nThis is a sandbox payment. Do not enter real card details.",
      "type": "text",
      "layout": {
        "row": "Row_intro"
      },
      "id": "Field_intro"
    },
    {
      "label": "Sandbox payment method",
      "values": [
        {
          "label": "Sandbox card: the payment succeeds",
          "value": "pm_card_visa"
        },
        {
          "label": "Sandbox card: the payment is declined",
          "value": "pm_card_chargeDeclined"
        },
        {
          "label": "Sandbox: the payment service is unavailable",
          "value": "pm_simulate_unavailable"
        },
        {
          "label": "Sandbox: the payment service does not answer",
          "value": "pm_simulate_no_answer"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_method"
      },
      "id": "Field_paymentMethod",
      "key": "paymentMethod",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default"
}