      <bpmndi:BPMNEdge id="Flow_ProducerStart_Decide_di" bpmnElement="Flow_ProducerStart_Decide">
        <di:waypoint x="906" y="540" />
        <di:waypoint x="950" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decide_Action_di" bpmnElement="Flow_Decide_Action">
        <di:waypoint x="1050" y="540" />
