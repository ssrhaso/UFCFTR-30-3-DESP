<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_SettleProducerPayments">
    <bpmn:documentation>P07 Settle producer payments, an additional operational model: none of the three use cases covers it. It follows FN2, which records each payment with the producer amounts and the 5% commission in DS3. P07 pays each producer weekly from those records (FR16, CS p. 2). i*: NW06, PR09, SD17, SD32, as in the strategic model. Draft for review.</bpmn:documentation>
    <bpmn:participant id="Participant_BRFNetwork" name="Bristol Regional Food Network marketplace" processRef="settle_producer_payments">
      <bpmn:documentation>A05. The network pool (D9), with the lane F03 Finance and settlements. settle_producer_payments (P07) is the executable process.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Producer" name="Producer">
      <bpmn:documentation>A04. Receives the weekly settlement statement (M10). Gives its bank details when they are missing (O09, O10). A separate pool, as in FN2, because the producer acts outside the engine.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_PaymentService" name="Payment service">
      <bpmn:documentation>E01. Sandbox or mock only (NFR02). In this draft E01 also pays the producers, which answers Q2 of actors.md for now.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_PayoutRequest" name="Payout request (O11)" sourceRef="SendTask_SendPayout" targetRef="Participant_PaymentService" />
    <bpmn:messageFlow id="MessageFlow_PayoutResult" name="Payout result (O12)" sourceRef="Participant_PaymentService" targetRef="ReceiveTask_WaitForPayoutResult" />
    <bpmn:messageFlow id="MessageFlow_SettlementStatement" name="Weekly settlement statement (M10)" sourceRef="SendTask_SendStatement" targetRef="Participant_Producer" />
    <bpmn:messageFlow id="MessageFlow_BankDetails" name="Bank details (O10)" sourceRef="Participant_Producer" targetRef="ReceiveTask_WaitForBankDetails" />
    <bpmn:messageFlow id="MessageFlow_BankDetailsRequest" name="Bank details request (O09)" sourceRef="SendTask_RequestBankDetails" targetRef="Participant_Producer" />
  </bpmn:collaboration>
  <bpmn:process id="settle_producer_payments" name="Settle producer payments" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0vuk52e">
      <bpmn:lane id="Lane_F03" name="Finance and settlements">
        <bpmn:documentation>F03 Finance and settlements, as in the strategic model. It owns P07: it collects the week's payments, pays each producer and keeps the audit trail (FR16, NFR08).</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_WeeklySettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_RunRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CollectPayments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ApproveRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RunApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RunStopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ChaseOpenPayouts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_SettleEachProducer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_PayoutsStillOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OpenPayoutsChased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RecordSettlementRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProducersSettled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_WeeklySettlement" name="Every Monday at 06:00">
      <bpmn:documentation>The weekly settlement date of the strategic model (Start_P07). FR16, CS p. 2. Draft rule: the run starts every Monday at 06:00 and settles the payments of the previous Monday to Sunday. The cron expression is 0 0 6 * * MON.</bpmn:documentation>
      <bpmn:outgoing>Flow_Weekly_JoinStart</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1tdx9zy">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 6 * * MON</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_RunRequested" name="Settlement run requested">
      <bpmn:documentation>Finance starts a run by hand: after a stopped run, or to show the process in the demo. The run then follows the same steps as the weekly run.</bpmn:documentation>
      <bpmn:outgoing>Flow_Requested_JoinStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Weekly_JoinStart" sourceRef="StartEvent_WeeklySettlement" targetRef="Gateway_JoinStart" />
    <bpmn:sequenceFlow id="Flow_Requested_JoinStart" sourceRef="StartEvent_RunRequested" targetRef="Gateway_JoinStart" />
    <bpmn:sequenceFlow id="Flow_JoinStart_Collect" sourceRef="Gateway_JoinStart" targetRef="ServiceTask_CollectPayments" />
    <bpmn:sequenceFlow id="Flow_Collect_Approval" sourceRef="ServiceTask_CollectPayments" targetRef="Gateway_ApprovalNeeded" />
    <bpmn:sequenceFlow id="Flow_Approval_Yes" name="Yes" sourceRef="Gateway_ApprovalNeeded" targetRef="UserTask_ApproveRun">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=runTotal &gt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approval_No" name="No" sourceRef="Gateway_ApprovalNeeded" targetRef="Gateway_JoinApproved" />
    <bpmn:sequenceFlow id="Flow_Approve_RunApproved" sourceRef="UserTask_ApproveRun" targetRef="Gateway_RunApproved" />
    <bpmn:sequenceFlow id="Flow_RunApproved_No" name="No" sourceRef="Gateway_RunApproved" targetRef="EndEvent_RunStopped" />
    <bpmn:sequenceFlow id="Flow_RunApproved_Yes" name="Yes" sourceRef="Gateway_RunApproved" targetRef="Gateway_JoinApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=runApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_JoinStart">
      <bpmn:documentation>Joins the two starts.</bpmn:documentation>
      <bpmn:incoming>Flow_Weekly_JoinStart</bpmn:incoming>
      <bpmn:incoming>Flow_Requested_JoinStart</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinStart_Collect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_CollectPayments" name="Collect the week&#39;s payments">
      <bpmn:documentation>R09, DS3. The worker reads the payments of the week that FN2 confirmed, with the amount of each producer and the 5% commission (B13, S4). It subtracts the refunds of the week and adds any balance carried from earlier weeks. It returns settlementRunId, periodStart, periodEnd, runTotal and producerSettlements: one entry per producer with producerId, grossAmount, commission, refunds, carriedIn, netAmount and bankDetailsOnFile.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collect-settlement-data" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinStart_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_Approval</bpmn:outgoing>
      <bpmn:property id="Property_1lcnug4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_CollectPayments">
        <bpmn:sourceRef>DataStoreReference_RecordsIn</bpmn:sourceRef>
        <bpmn:targetRef>Property_1lcnug4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ApprovalNeeded" name="Run total over £10,000?" default="Flow_Approval_No">
      <bpmn:documentation>Draft rule: a second person approves a large run before any money leaves the network (a four-eyes check on financial transactions, E05).</bpmn:documentation>
      <bpmn:incoming>Flow_Collect_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approval_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ApproveRun" name="Approve the settlement run">
      <bpmn:documentation>The finance manager checks the totals of the run against DS3, then approves the run or stops it. Form approve-settlement-run (to add). It sets runApproved.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="approve-settlement-run" />
        <zeebe:assignmentDefinition candidateGroups="finance-manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approval_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_RunApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RunApproved" name="Run approved?" default="Flow_RunApproved_No">
      <bpmn:incoming>Flow_Approve_RunApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_RunApproved_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_RunApproved_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinApproved">
      <bpmn:documentation>Joins the approved run and the run below the limit.</bpmn:documentation>
      <bpmn:incoming>Flow_Approval_No</bpmn:incoming>
      <bpmn:incoming>Flow_RunApproved_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinApproved_Settle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RunStopped" name="Run stopped for checks">
      <bpmn:documentation>No payout is sent. Finance corrects the records, then starts the run again (Settlement run requested).</bpmn:documentation>
      <bpmn:incoming>Flow_RunApproved_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_SettleEachProducer" name="Settle each producer">
      <bpmn:documentation>FR16. One instance for each entry of producerSettlements, in parallel. Each instance pays the producer, leaves a small balance for next week, or holds the payout until the bank details arrive. The input mappings make the variables local, so the instances do not overwrite each other. settlementResults collects the outcome of each producer for the audit trail.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="payoutAction" />
          <zeebe:input source="=null" target="payoutRequestId" />
          <zeebe:input source="=null" target="payoutStatus" />
          <zeebe:input source="=null" target="payoutReference" />
          <zeebe:input source="=null" target="failureReason" />
          <zeebe:input source="=null" target="retryDecision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinApproved_Settle</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_Record</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerSettlements" inputElement="settlement" outputCollection="settlementResults" outputElement="={producerId: settlement.producerId, payoutAction: payoutAction, payoutStatus: payoutStatus, payoutReference: payoutReference, retryDecision: retryDecision}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="StartEvent_ProducerToSettle" name="Producer to settle">
        <bpmn:documentation>One entry of producerSettlements, in the local variable settlement.</bpmn:documentation>
        <bpmn:outgoing>Flow_ProducerStart_Decide</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="BusinessRuleTask_DecidePayout" name="Decide the payout">
        <bpmn:documentation>DMN decision payout-decision (to add). Inputs: settlement.netAmount and settlement.bankDetailsOnFile. Draft rule: below £5.00, including zero or less after refunds, gives CARRY_OVER. No bank details gives HOLD. Otherwise PAY. It sets payoutAction.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="payout-decision" resultVariable="payoutAction" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ProducerStart_Decide</bpmn:incoming>
        <bpmn:outgoing>Flow_Decide_Action</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_ProducerStart_Decide" sourceRef="StartEvent_ProducerToSettle" targetRef="BusinessRuleTask_DecidePayout" />
      <bpmn:exclusiveGateway id="Gateway_PayoutAction" name="Payout action?" default="Flow_Action_CarryOver">
        <bpmn:incoming>Flow_Decide_Action</bpmn:incoming>
        <bpmn:outgoing>Flow_Action_Pay</bpmn:outgoing>
        <bpmn:outgoing>Flow_Action_CarryOver</bpmn:outgoing>
        <bpmn:outgoing>Flow_Action_Hold</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_Decide_Action" sourceRef="BusinessRuleTask_DecidePayout" targetRef="Gateway_PayoutAction" />
      <bpmn:exclusiveGateway id="Gateway_JoinPay">
        <bpmn:documentation>Joins the two ways to the payout.</bpmn:documentation>
        <bpmn:incoming>Flow_Action_Pay</bpmn:incoming>
        <bpmn:incoming>Flow_Save_JoinPay</bpmn:incoming>
        <bpmn:outgoing>Flow_JoinPay_JoinRetry</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_JoinRetry">
        <bpmn:documentation>Joins a retry after a failed payout.</bpmn:documentation>
        <bpmn:incoming>Flow_JoinPay_JoinRetry</bpmn:incoming>
        <bpmn:incoming>Flow_Retry_Yes</bpmn:incoming>
        <bpmn:outgoing>Flow_JoinRetry_Send</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_Action_Pay" name="Pay" sourceRef="Gateway_PayoutAction" targetRef="Gateway_JoinPay">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=payoutAction = "PAY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_JoinPay_JoinRetry" sourceRef="Gateway_JoinPay" targetRef="Gateway_JoinRetry" />
      <bpmn:sendTask id="SendTask_SendPayout" name="Send the payout">
        <bpmn:documentation>O11 (new). The worker asks the sandbox or mock payment service (NFR02) to pay settlement.netAmount to the producer. It sends settlementRunId and producerId as the idempotency key, so a retry cannot pay twice (NFR05). It returns payoutRequestId.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-payout" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_JoinRetry_Send</bpmn:incoming>
        <bpmn:outgoing>Flow_Send_WaitResult</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_JoinRetry_Send" sourceRef="Gateway_JoinRetry" targetRef="SendTask_SendPayout" />
      <bpmn:receiveTask id="ReceiveTask_WaitForPayoutResult" name="Wait for the payout result" messageRef="Message_28b2l1g">
        <bpmn:documentation>O12 (new). Message payout-result, correlated on payoutRequestId. It sets payoutStatus (CONFIRMED or FAILED), payoutReference and failureReason.</bpmn:documentation>
        <bpmn:incoming>Flow_Send_WaitResult</bpmn:incoming>
        <bpmn:outgoing>Flow_WaitResult_Confirmed</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sequenceFlow id="Flow_Send_WaitResult" sourceRef="SendTask_SendPayout" targetRef="ReceiveTask_WaitForPayoutResult" />
      <bpmn:exclusiveGateway id="Gateway_PayoutConfirmed" name="Payout confirmed?" default="Flow_Confirmed_No">
        <bpmn:incoming>Flow_WaitResult_Confirmed</bpmn:incoming>
        <bpmn:outgoing>Flow_Confirmed_Yes</bpmn:outgoing>
        <bpmn:outgoing>Flow_Confirmed_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_WaitResult_Confirmed" sourceRef="ReceiveTask_WaitForPayoutResult" targetRef="Gateway_PayoutConfirmed" />
      <bpmn:sendTask id="SendTask_SendStatement" name="Send the settlement statement">
        <bpmn:documentation>M10, FR16. The statement lists the orders of the week, the 5% commission, the refunds, the amount paid and the payout reference. It is the audit trail that the producer uses for its tax report (E06).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-settlement-statement" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Confirmed_Yes</bpmn:incoming>
        <bpmn:outgoing>Flow_Statement_Paid</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_Confirmed_Yes" name="Yes" sourceRef="Gateway_PayoutConfirmed" targetRef="SendTask_SendStatement">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=payoutStatus = "CONFIRMED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="EndEvent_ProducerPaid" name="Producer paid">
        <bpmn:incoming>Flow_Statement_Paid</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Statement_Paid" sourceRef="SendTask_SendStatement" targetRef="EndEvent_ProducerPaid" />
      <bpmn:endEvent id="EndEvent_BalanceCarried" name="Balance carried to next week">
        <bpmn:documentation>Nothing is paid this week. The balance stays in DS3, and next week's run adds it (carriedIn). NFR05: no amount is lost or paid twice.</bpmn:documentation>
        <bpmn:incoming>Flow_Action_CarryOver</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Action_CarryOver" name="Below the minimum" sourceRef="Gateway_PayoutAction" targetRef="EndEvent_BalanceCarried" />
      <bpmn:sequenceFlow id="Flow_Action_Hold" name="Bank details missing" sourceRef="Gateway_PayoutAction" targetRef="SendTask_RequestBankDetails">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=payoutAction = "HOLD"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Request_WaitDetails" sourceRef="SendTask_RequestBankDetails" targetRef="ReceiveTask_WaitForBankDetails" />
      <bpmn:sequenceFlow id="Flow_WaitDetails_Save" sourceRef="ReceiveTask_WaitForBankDetails" targetRef="ServiceTask_SaveBankDetails" />
      <bpmn:sequenceFlow id="Flow_Save_JoinPay" sourceRef="ServiceTask_SaveBankDetails" targetRef="Gateway_JoinPay" />
      <bpmn:sendTask id="SendTask_RequestBankDetails" name="Ask the producer for bank details">
        <bpmn:documentation>O09 (new). The worker asks the producer for the account to pay into.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-bank-details" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Action_Hold</bpmn:incoming>
        <bpmn:outgoing>Flow_Request_WaitDetails</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask_WaitForBankDetails" name="Wait for the bank details" messageRef="Message_0j7rs7g">
        <bpmn:documentation>O10 (new). Message bank-details-received, correlated on settlement.producerId.</bpmn:documentation>
        <bpmn:incoming>Flow_Request_WaitDetails</bpmn:incoming>
        <bpmn:outgoing>Flow_WaitDetails_Save</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="BoundaryEvent_NoBankDetails" name="No reply in 3 days" attachedToRef="ReceiveTask_WaitForBankDetails">
        <bpmn:documentation>Draft rule: after 3 days the payout waits for next week's run.</bpmn:documentation>
        <bpmn:outgoing>Flow_NoBankDetails_Held</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0rh0s3x">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="EndEvent_PayoutHeld" name="Payout held for next week">
        <bpmn:documentation>Nothing is paid this week. The balance stays in DS3 for next week's run.</bpmn:documentation>
        <bpmn:incoming>Flow_NoBankDetails_Held</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_NoBankDetails_Held" sourceRef="BoundaryEvent_NoBankDetails" targetRef="EndEvent_PayoutHeld" />
      <bpmn:serviceTask id="ServiceTask_SaveBankDetails" name="Save the bank details">
        <bpmn:documentation>The worker stores the producer's account details. The run continues to the payout.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="save-bank-details" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_WaitDetails_Save</bpmn:incoming>
        <bpmn:outgoing>Flow_Save_JoinPay</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="BoundaryEvent_NoPayoutAnswer" name="No answer in 1 hour" attachedToRef="ReceiveTask_WaitForPayoutResult">
        <bpmn:documentation>Draft rule: no answer within 1 hour counts as a failed payout.</bpmn:documentation>
        <bpmn:outgoing>Flow_NoAnswer_JoinFailed</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_083ceyz">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Gateway_JoinFailed">
        <bpmn:documentation>Joins a failed payout and a payout with no answer.</bpmn:documentation>
        <bpmn:incoming>Flow_NoAnswer_JoinFailed</bpmn:incoming>
        <bpmn:incoming>Flow_Confirmed_No</bpmn:incoming>
        <bpmn:outgoing>Flow_JoinFailed_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_NoAnswer_JoinFailed" sourceRef="BoundaryEvent_NoPayoutAnswer" targetRef="Gateway_JoinFailed" />
      <bpmn:sequenceFlow id="Flow_Confirmed_No" name="No" sourceRef="Gateway_PayoutConfirmed" targetRef="Gateway_JoinFailed" />
      <bpmn:sequenceFlow id="Flow_JoinFailed_Review" sourceRef="Gateway_JoinFailed" targetRef="UserTask_ReviewFailedPayout" />
      <bpmn:userTask id="UserTask_ReviewFailedPayout" name="Review the failed payout">
        <bpmn:documentation>Finance checks failureReason, for example a closed account, then chooses to try again or to hold the payout for next week. Form review-failed-payout (to add). It sets retryDecision.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="review-failed-payout" />
          <zeebe:assignmentDefinition candidateGroups="finance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_JoinFailed_Review</bpmn:incoming>
        <bpmn:outgoing>Flow_Review_Retry</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_RetryPayout" name="Try the payout again?" default="Flow_Retry_No">
        <bpmn:incoming>Flow_Review_Retry</bpmn:incoming>
        <bpmn:outgoing>Flow_Retry_No</bpmn:outgoing>
        <bpmn:outgoing>Flow_Retry_Yes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_Review_Retry" sourceRef="UserTask_ReviewFailedPayout" targetRef="Gateway_RetryPayout" />
      <bpmn:endEvent id="EndEvent_PayoutHeldAfterFailure" name="Payout held for next week">
        <bpmn:documentation>Nothing is paid this week. The balance stays in DS3 for next week's run.</bpmn:documentation>
        <bpmn:incoming>Flow_Retry_No</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Retry_No" name="No" sourceRef="Gateway_RetryPayout" targetRef="EndEvent_PayoutHeldAfterFailure" />
      <bpmn:sequenceFlow id="Flow_Retry_Yes" name="Yes" sourceRef="Gateway_RetryPayout" targetRef="Gateway_JoinRetry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryDecision = "RETRY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_JoinApproved_Settle" sourceRef="Gateway_JoinApproved" targetRef="SubProcess_SettleEachProducer" />
    <bpmn:userTask id="UserTask_ChaseOpenPayouts" name="Chase the open payouts">
      <bpmn:documentation>The finance manager contacts the producers whose bank details or failed payouts are still open. Form chase-open-payouts (to add).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="chase-open-payouts" />
        <zeebe:assignmentDefinition candidateGroups="finance-manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StillOpen_Chase</bpmn:incoming>
      <bpmn:outgoing>Flow_Chase_Chased</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_StillOpen_Chase" sourceRef="BoundaryEvent_PayoutsStillOpen" targetRef="UserTask_ChaseOpenPayouts" />
    <bpmn:endEvent id="EndEvent_OpenPayoutsChased" name="Open payouts chased">
      <bpmn:incoming>Flow_Chase_Chased</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Chase_Chased" sourceRef="UserTask_ChaseOpenPayouts" targetRef="EndEvent_OpenPayoutsChased" />
    <bpmn:boundaryEvent id="BoundaryEvent_PayoutsStillOpen" name="Payouts still open after 2 days" cancelActivity="false" attachedToRef="SubProcess_SettleEachProducer">
      <bpmn:documentation>Non-interrupting: the open instances keep waiting. Draft rule: a run should finish within 2 days, so after that the finance manager chases what is still open.</bpmn:documentation>
      <bpmn:outgoing>Flow_StillOpen_Chase</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0ba86to">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask_RecordSettlementRun" name="Record the settlement run">
      <bpmn:documentation>NFR08, FR16. The worker writes the audit trail of the run to DS3: for each producer the gross amount, the 5% commission, the refunds, the amount paid, carried or held, and the payout reference. The producers use this trail for their tax reports (E06).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-settlement-run" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Settle_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_Settled</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_RecordSettlementRun">
        <bpmn:targetRef>DataStoreReference_RecordsOut</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ProducersSettled" name="Producers settled">
      <bpmn:documentation>The end of P07 in the strategic model (End_P07).</bpmn:documentation>
      <bpmn:incoming>Flow_Record_Settled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Record_Settled" sourceRef="ServiceTask_RecordSettlementRun" targetRef="EndEvent_ProducersSettled" />
    <bpmn:dataStoreReference id="DataStoreReference_RecordsIn" name="Payment and settlement records (DS3)">
      <bpmn:documentation>DS3, owned by F03. FN2 writes the payments. P07 reads them here.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStoreReference_RecordsOut" name="Payment and settlement records (DS3)">
      <bpmn:documentation>The same store DS3. P07 writes the settlement records here.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_Settle_Record" sourceRef="SubProcess_SettleEachProducer" targetRef="ServiceTask_RecordSettlementRun" />
  </bpmn:process>
  <bpmn:message id="Message_28b2l1g" name="payout-result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=payoutRequestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_0j7rs7g" name="bank-details-received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=settlement.producerId" />
    </bpmn:extensionElements>
  </bpmn:message>
