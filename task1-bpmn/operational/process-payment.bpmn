        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0odb0oe_di" bpmnElement="ServiceTask_SubmitPayment">
        <dc:Bounds x="980" y="430" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1xvpr59_di" bpmnElement="Gateway_PaymentResult">
        <dc:Bounds x="1115" y="445" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="412" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1l16nop_di" bpmnElement="Gateway_JoinUnavailable" isMarkerVisible="true">
        <dc:Bounds x="975" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_18o9pfw_di" bpmnElement="Event_NoAnswer">
        <dc:Bounds x="1122" y="562" width="36" height="36" />
