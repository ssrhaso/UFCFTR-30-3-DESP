<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ProcessOrder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="61e4b3b" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_ProcessOrder">
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_BRFNetwork" name="BRF Network: Process order" processRef="process_order" />
    <bpmn:participant id="Participant_StockService" name="Stock service" />
    <bpmn:messageFlow id="M04" name="Order checkout" sourceRef="Participant_Customer" targetRef="Start_Checkout" />
    <bpmn:messageFlow id="O01" name="Stock unavailable notice" sourceRef="Task_AmendOrder" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="O02" name="Amended ordder" sourceRef="Participant_Customer" targetRef="Task_AmendOrder" />
    <bpmn:messageFlow id="Msg_OrderSummary" name="Order summary" sourceRef="Task_ReviewOrder" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="Msg_CustomerDecision" name="Customer decision" sourceRef="Participant_Customer" targetRef="Task_ReviewOrder" />
    <bpmn:messageFlow id="Msg_StockCheckRequest" name="Stock check request" sourceRef="Task_CheckStock" targetRef="Participant_StockService" />
    <bpmn:messageFlow id="Msg_StockLevels" name="Stock check result" sourceRef="Participant_StockService" targetRef="Task_CheckStock" />
    <bpmn:messageFlow id="Msg_ReserveRequest" name="Reserve request" sourceRef="Task_ReserveStock" targetRef="Participant_StockService" />
    <bpmn:messageFlow id="Msg_ReservationConfirmation" name="Reservation confirmation" sourceRef="Participant_StockService" targetRef="Task_ReserveStock" />
    <bpmn:messageFlow id="Msg_ReleaseRequest" name="Release request" sourceRef="Task_ReleaseReservation" targetRef="Participant_StockService" />
  </bpmn:collaboration>
  <bpmn:process id="process_order" name="Process order" isExecutable="true">
    <bpmn:laneSet id="LaneSet_ProcessOrder">
      <bpmn:lane id="Lane_F02" name="Order Managment">
        <bpmn:flowNodeRef>Start_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AmendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AmendOrCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CancelledByCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyProducers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SplitOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderAwaitingPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineArrangements</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F01" name="Catalogue managment">
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReserveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseReservation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderNotPlaced</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Checkout" name="Customer proceeds to checkout">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckStock" name="Check stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ItemsAvailable" name="All items available?" default="Flow_04">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AmendOrder" name="Amend order or cancel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-amend-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AmendOrCancel" name="Amend or cancel?" default="Flow_07">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CancelledByCustomer" name="Order cancelled by customer">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ReserveStock" name="Reserve stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_IdentifyProducers" name="Identify producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="identify-producers" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReleaseReservation" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderNotPlaced" name="Order not placed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateOrder" name="Create marketplace order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SplitOrder" name="Split into producer order elements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="split-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderAwaitingPayment" name="Order awaiting payment">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Checkout" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CheckStock" targetRef="Gateway_ItemsAvailable" />
    <bpmn:sequenceFlow id="Flow_03" name="No" sourceRef="Gateway_ItemsAvailable" targetRef="Task_AmendOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(allAvailable)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" name="Yes" sourceRef="Gateway_ItemsAvailable" targetRef="Task_ReserveStock" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AmendOrder" targetRef="Gateway_AmendOrCancel" />
    <bpmn:sequenceFlow id="Flow_06" name="Cancel" sourceRef="Gateway_AmendOrCancel" targetRef="End_CancelledByCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= amendDecision = "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="Amend" sourceRef="Gateway_AmendOrCancel" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReserveStock" targetRef="Task_IdentifyProducers" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_IdentifyProducers" targetRef="Task_DetermineArrangements" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReviewOrder" targetRef="Gateway_Confirmed" />
    <bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="Gateway_Confirmed" targetRef="Task_CreateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_Confirmed" targetRef="Task_ReleaseReservation" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReleaseReservation" targetRef="End_OrderNotPlaced" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CreateOrder" targetRef="Task_SplitOrder" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SplitOrder" targetRef="End_OrderAwaitingPayment" />
    <bpmn:sequenceFlow id="Flow_0zudwgo" sourceRef="Task_DetermineArrangements" targetRef="Task_ReviewOrder" />
    <bpmn:userTask id="Task_ReviewOrder" name="Review and confirm order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-review-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zudwgo</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Confirmed" name="Order confirmed?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_DetermineArrangements" name="Determine delivery or collection per producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="determine-arrangements" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_0zudwgo</bpmn:outgoing>
    </bpmn:businessRuleTask>
  </bpmn:process>
  <bpmn:message id="Message_DistanceResult" name="distance-result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= checkoutId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_StockServiceUnavailable" name="STOCK_SERVICE_UNAVAILABLE" errorCode="STOCK_SERVICE_UNAVAILABLE" />
