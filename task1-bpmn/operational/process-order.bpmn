<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ProcessOrder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_ProcessOrder">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_BRFNetwork" name="Bristol Regional Food Network marketplace" processRef="process_order" />
    <bpmn:participant id="Participant_StockService" name="Stock service" />
    <bpmn:messageFlow id="M04" name="Order" sourceRef="Task_ProceedToCheckout" targetRef="Participant_BRFNetwork" />
    <bpmn:messageFlow id="O01" name="Stock unavailable notice" sourceRef="Task_AmendOrder" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="O02" name="Amended order" sourceRef="Participant_Customer" targetRef="Task_AmendOrder" />
    <bpmn:messageFlow id="Msg_OrderSummary" name="Order summary" sourceRef="Task_ReviewOrder" targetRef="Task_CustomerReview" />
    <bpmn:messageFlow id="Msg_CustomerDecision" name="Customer decision" sourceRef="Task_CustomerReview" targetRef="Task_ReviewOrder" />
    <bpmn:messageFlow id="Msg_StockCheckRequest" name="Stock check request" sourceRef="Task_CheckStock" targetRef="Participant_StockService" />
    <bpmn:messageFlow id="Msg_StockLevels" name="Stock check result" sourceRef="Participant_StockService" targetRef="Task_CheckStock" />
    <bpmn:messageFlow id="Msg_ReserveRequest" name="Reserve request" sourceRef="Task_ReserveStock" targetRef="Participant_StockService" />
    <bpmn:messageFlow id="Msg_ReservationConfirmation" name="Reservation confirmation" sourceRef="Participant_StockService" targetRef="Task_ReserveStock" />
    <bpmn:messageFlow id="Msg_ReleaseRequest" name="Release request" sourceRef="Task_ReleaseReservation" targetRef="Participant_StockService" />
    <bpmn:messageFlow id="Msg_ReleaseRequestOnAmend" name="Release request" sourceRef="Task_ReleaseOnAmend" targetRef="Participant_StockService" />
  </bpmn:collaboration>
  <bpmn:process id="process_order" name="Process order" isExecutable="true">
    <bpmn:laneSet id="LaneSet_ProcessOrder">
      <bpmn:lane id="Lane_F02" name="Order management">
        <bpmn:flowNodeRef>Start_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Link_RecheckStockCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AmendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_AmendTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AmendOrCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AmendEndMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockHeld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CancelledByCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyProducers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineArrangements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateFoodMiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateTotal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviewTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviewReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReminderSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Link_RecheckStockThrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReleaseMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SplitOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderAwaitingPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_StockFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F01" name="Catalogue management">
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReserveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_StockTaken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UnavailableMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindSubstitutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseOnAmend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotPlacedOnAmend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseReservation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderNotPlaced</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Checkout" name="Customer proceeds to checkout">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_CheckMerge">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Link_RecheckStockCatch" name="Recheck stock">
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkDef_RecheckStockCatch" name="Recheck stock" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CheckStock" name="Check stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ItemsAvailable" name="All items available?" default="Flow_03">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReserveStock" name="Reserve stock">
      <bpmn:documentation>Returns reservationId, reservationExpiresAt and reservationReminderAt. The two timers on the review task read the last two.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_StockTaken" name="Stock taken by another customer" attachedToRef="Task_ReserveStock">
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_StockTaken" errorRef="Error_InsufficientStock" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_UnavailableMerge">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FindSubstitutes" name="Find substitutes from other producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="find-substitutes" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AmendOrder" name="Amend order or cancel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-amend-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_AmendTimer" name="Amend time limit reached" attachedToRef="Task_AmendOrder">
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Amend">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_AmendOrCancel" name="Amend or cancel?" default="Flow_06">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AmendEndMerge">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_StockHeld" name="Stock held?" default="Flow_31">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CancelledByCustomer" name="Order ended before reservation">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ReleaseOnAmend" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NotPlacedOnAmend" name="Order not placed during amendment">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_IdentifyProducers" name="Identify producers">
      <bpmn:documentation>Also returns addOnSuggestions: in-stock products of the producers already in the order, surplus offers first.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="identify-producers" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_DetermineArrangements" name="Determine delivery or collection per producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="determine-arrangements" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_CalculateFoodMiles" name="Calculate food miles">
      <bpmn:documentation>B09, optional. With a missing or invalid postcode the worker returns no distance and the order continues.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-food-miles" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CalculateTotal" name="Calculate order total with surplus discounts">
      <bpmn:documentation>Applies the producer-set surplus discount (R15) to the order lines and sums the total that the customer confirms.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-order-total" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewOrder" name="Review and confirm order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-review-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ReviewTimer" name="Stock hold expired" attachedToRef="Task_ReviewOrder">
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Hold">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">= reservationExpiresAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_ReviewReminder" name="Hold about to expire" cancelActivity="false" attachedToRef="Task_ReviewOrder">
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Reminder">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">= reservationReminderAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_SendReminder" name="Send hold reminder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Link_RecheckStockThrow" name="Recheck stock">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_RecheckStockThrow" name="Recheck stock" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_Confirmed" name="Customer decision?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ReleaseMerge">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseReservation" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderNotPlaced" name="Order not placed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateOrder" name="Create marketplace order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SplitOrder" name="Split into producer order elements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="split-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderAwaitingPayment" name="Order awaiting payment">
      <bpmn:documentation>Named end state for the hand-over. The parent process calls Process payment next (proposal for S2).</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_StockFailure" name="Stock service unavailable" triggeredByEvent="true">
      <bpmn:startEvent id="Start_StockFailure" name="Stock service unavailable">
        <bpmn:outgoing>Flow_38</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_StockFailure" errorRef="Error_StockServiceUnavailable" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_TellCustomerUnavailable" name="Tell customer that checkout is unavailable">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-customer" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_38</bpmn:incoming>
        <bpmn:outgoing>Flow_39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_CheckoutFailed" name="Checkout failed">
        <bpmn:incoming>Flow_39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_38" sourceRef="Start_StockFailure" targetRef="Task_TellCustomerUnavailable" />
      <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_TellCustomerUnavailable" targetRef="End_CheckoutFailed" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Checkout" targetRef="Gateway_CheckMerge" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Link_RecheckStockCatch" targetRef="Gateway_CheckMerge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_CheckMerge" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CheckStock" targetRef="Gateway_ItemsAvailable" />
    <bpmn:sequenceFlow id="Flow_04" name="Yes" sourceRef="Gateway_ItemsAvailable" targetRef="Task_ReserveStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03" name="No" sourceRef="Gateway_ItemsAvailable" targetRef="Gateway_UnavailableMerge" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Boundary_StockTaken" targetRef="Gateway_UnavailableMerge" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_UnavailableMerge" targetRef="Task_FindSubstitutes" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_FindSubstitutes" targetRef="Task_AmendOrder" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AmendOrder" targetRef="Gateway_AmendOrCancel" />
    <bpmn:sequenceFlow id="Flow_07" name="Amend" sourceRef="Gateway_AmendOrCancel" targetRef="Gateway_CheckMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= amendDecision = "amend"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="Cancel" sourceRef="Gateway_AmendOrCancel" targetRef="Gateway_AmendEndMerge" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Boundary_AmendTimer" targetRef="Gateway_AmendEndMerge" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_AmendEndMerge" targetRef="Gateway_StockHeld" />
    <bpmn:sequenceFlow id="Flow_30" name="Yes" sourceRef="Gateway_StockHeld" targetRef="Task_ReleaseOnAmend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reservationId != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" name="No" sourceRef="Gateway_StockHeld" targetRef="End_CancelledByCustomer" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ReleaseOnAmend" targetRef="End_NotPlacedOnAmend" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReserveStock" targetRef="Task_IdentifyProducers" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_IdentifyProducers" targetRef="Task_DetermineArrangements" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DetermineArrangements" targetRef="Task_CalculateFoodMiles" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_CalculateFoodMiles" targetRef="Task_CalculateTotal" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_CalculateTotal" targetRef="Task_ReviewOrder" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReviewOrder" targetRef="Gateway_Confirmed" />
    <bpmn:sequenceFlow id="Flow_13" name="Confirm" sourceRef="Gateway_Confirmed" targetRef="Task_CreateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" name="Add items" sourceRef="Gateway_Confirmed" targetRef="Link_RecheckStockThrow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "addItems"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="Cancel" sourceRef="Gateway_Confirmed" targetRef="Gateway_ReleaseMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Boundary_ReviewTimer" targetRef="Gateway_ReleaseMerge" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_ReleaseMerge" targetRef="Task_ReleaseReservation" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReleaseReservation" targetRef="End_OrderNotPlaced" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Boundary_ReviewReminder" targetRef="Task_SendReminder" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_SendReminder" targetRef="End_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CreateOrder" targetRef="Task_SplitOrder" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SplitOrder" targetRef="End_OrderAwaitingPayment" />
  </bpmn:process>
  <bpmn:process id="Process_Customer" name="Customer" isExecutable="false">
    <bpmn:startEvent id="Start_Customer" name="Basket ready for checkout">
      <bpmn:outgoing>Flow_Customer_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ProceedToCheckout" name="Proceed to checkout">
      <bpmn:incoming>Flow_Customer_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Customer_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CustomerReview" name="Review and confirm order">
      <bpmn:incoming>Flow_Customer_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Customer_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Customer" name="Purchase confirmed">
      <bpmn:incoming>Flow_Customer_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Customer_01" sourceRef="Start_Customer" targetRef="Task_ProceedToCheckout" />
    <bpmn:sequenceFlow id="Flow_Customer_02" sourceRef="Task_ProceedToCheckout" targetRef="Task_CustomerReview" />
    <bpmn:sequenceFlow id="Flow_Customer_03" sourceRef="Task_CustomerReview" targetRef="End_Customer" />
  </bpmn:process>
  <bpmn:error id="Error_StockServiceUnavailable" name="STOCK_SERVICE_UNAVAILABLE" errorCode="STOCK_SERVICE_UNAVAILABLE" />
  <bpmn:error id="Error_InsufficientStock" name="INSUFFICIENT_STOCK" errorCode="INSUFFICIENT_STOCK" />
