<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Strategic" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="5acd1b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_Strategic">
    <bpmn:documentation>Figure 1: strategic BPMN model of the Bristol Regional Food Network marketplace. Pools from requirements/strategic/actors.md, lanes and processes from requirements/strategic/processes.md, message flows M01 to M25 from interactions.md section 3.1. The data relationships between the processes are recorded in interactions.md section 4.2 and are not drawn (D7). The BRF Network process is marked executable and its conditions are FEEL expressions only because Camunda Web Modeler requires one executable process per diagram; the strategic model is not deployed. Each element cites its i* elements (task1-bpmn/istar/model-content.md) after "i*:".</bpmn:documentation>
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_BRFNetwork" name="BRF Network" processRef="Process_BRFNetwork" />
    <bpmn:participant id="Participant_Producer" name="Producer" processRef="Process_Producer" />
    <bpmn:participant id="Participant_PaymentService" name="Payment service" />
    <bpmn:participant id="Participant_CertificationService" name="Organic certification verification service" />
    <bpmn:participant id="Participant_NotificationService" name="Notification service" />
    <bpmn:participant id="Participant_PostcodeService" name="Postcode distance service" />
    <bpmn:messageFlow id="M01" name="Product listing" sourceRef="Participant_Producer" targetRef="Start_P01" />
    <bpmn:messageFlow id="M02" name="Certification check request" sourceRef="P02" targetRef="Participant_CertificationService" />
    <bpmn:messageFlow id="M03" name="Certification result" sourceRef="Participant_CertificationService" targetRef="P02" />
    <bpmn:messageFlow id="M04" name="Order" sourceRef="Participant_Customer" targetRef="P04" />
    <bpmn:messageFlow id="M05" name="Payment request" sourceRef="P05" targetRef="Participant_PaymentService" />
    <bpmn:messageFlow id="M06" name="Payment response" sourceRef="Participant_PaymentService" targetRef="P05" />
    <bpmn:messageFlow id="M07" name="Order confirmation" sourceRef="P05" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="M08" name="New order notification request" sourceRef="P05" targetRef="Participant_NotificationService" />
    <bpmn:messageFlow id="M09" name="New order notification" sourceRef="Participant_NotificationService" targetRef="Start_P06" />
    <bpmn:messageFlow id="M10" name="Weekly settlement" sourceRef="P07" targetRef="Participant_Producer" />
    <bpmn:messageFlow id="M11" name="Quality concern report" sourceRef="Participant_Customer" targetRef="Start_P08" />
    <bpmn:messageFlow id="M12" name="Quality concern or incident information" sourceRef="Participant_Producer" targetRef="P08" />
    <bpmn:messageFlow id="M13" name="Incident notice" sourceRef="P08" targetRef="Participant_Producer" />
    <bpmn:messageFlow id="M14" name="Food safety notification request" sourceRef="P08" targetRef="Participant_NotificationService" />
    <bpmn:messageFlow id="M15" name="Food safety notification" sourceRef="Participant_NotificationService" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="M16" name="Postcode" sourceRef="Participant_Customer" targetRef="Start_P09" />
    <bpmn:messageFlow id="M17" name="Distance request" sourceRef="P09" targetRef="Participant_PostcodeService" />
    <bpmn:messageFlow id="M18" name="Distance result" sourceRef="Participant_PostcodeService" targetRef="P09" />
    <bpmn:messageFlow id="M19" name="Surplus produce report" sourceRef="Participant_Producer" targetRef="Start_P10" />
    <bpmn:messageFlow id="M20" name="Surplus offer notification request" sourceRef="P10" targetRef="Participant_NotificationService" />
    <bpmn:messageFlow id="M21" name="Surplus offer" sourceRef="Participant_NotificationService" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="M22" name="Educational content" sourceRef="Participant_Producer" targetRef="Start_P11" />
    <bpmn:messageFlow id="M23" name="Amend order" sourceRef="Event_AmendOrder" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="M24" name="Order issue report" sourceRef="Participant_Customer" targetRef="Start_P12" />
    <bpmn:messageFlow id="M25" name="Issue resolution" sourceRef="P12" targetRef="Participant_Customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BRFNetwork" name="BRF Network" isExecutable="true">
    <bpmn:laneSet id="LaneSet_BRFNetwork">
      <bpmn:lane id="Lane_F05" name="Community and sustainability">
        <bpmn:flowNodeRef>Start_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F04" name="Quality and traceability">
        <bpmn:flowNodeRef>P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CertificationVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ListingNotPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F03" name="Finance and settlements">
        <bpmn:flowNodeRef>End_UC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentSucceeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PaymentNotCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F02" name="Order management">
        <bpmn:flowNodeRef>Start_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_F01" name="Catalogue management">
        <bpmn:flowNodeRef>Start_UC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemsInStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AmendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrganicClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P01</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_UC2" name="Customer opens the marketplace">
      <bpmn:documentation>A none start event: the customer visits the marketplace on their own initiative, which is not a message to the network. P04 receives the order (M04) when the customer proceeds to checkout (R05). i*: CU02.</bpmn:documentation>
      <bpmn:outgoing>Flow_BRF_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ItemsInStock" name="Items in stock?" default="Flow_BRF_32">
      <bpmn:documentation>B01, R04. The stock kept by F01 (DS1) is checked before the marketplace order is created in P04. When an item is unavailable the customer is asked to amend the basket (O01, O02) and continues browsing. Operational detail: process_order, check-stock. i*: MP06, CU08.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_BRF_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_AmendOrder" name="Amend order requested">
      <bpmn:documentation>Sends M23 "Amend order" to the customer (O01). The customer amends the basket (O02) and continues browsing (CU08). i*: MP07, CU08.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="amend-order-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BRF_32</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Event_AmendOrder" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="P03" name="Browse and search catalogue">
      <bpmn:documentation>P03. Owner: F01 Catalogue management. Use Case 2 starts here. See requirements/strategic/processes.md, section 3. i*: CU02, CU04, SD02.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_01</bpmn:incoming>
      <bpmn:incoming>Flow_BRF_33</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_UC2" name="Order confirmed">
      <bpmn:documentation>The payment succeeded and the order is confirmed to the customer (M07). The stock update by F01 and the producer notifications by F02 (M08, M09) happen inside P05; see processes.md, section 4. i*: MP18, MP19.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P01" name="Product details received">
      <bpmn:outgoing>Flow_BRF_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P01" messageRef="Message_ProductDetails" />
    </bpmn:startEvent>
    <bpmn:task id="P01" name="Manage products">
      <bpmn:documentation>P01. Owner: F01 Catalogue management. See requirements/strategic/processes.md, section 3. i*: PR04, SD11.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_10</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_OrganicClaim" name="Organic claim?" default="Flow_BRF_27">
      <bpmn:documentation>R01 and R02. A listing that claims organic certification goes to P02 for verification before it is published. See requirements/strategic/interactions.md, section 4.2.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_11</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_BRF_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_P01" name="Listing published">
      <bpmn:incoming>Flow_BRF_27</bpmn:incoming>
      <bpmn:incoming>Flow_BRF_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P07" name="Weekly settlement date">
      <bpmn:outgoing>Flow_BRF_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Start_P07">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="P07" name="Settle producer payments">
      <bpmn:documentation>P07. Owner: F03 Finance and settlements. Amount of each producer less the 5% commission, with an audit trail. See requirements/strategic/processes.md, section 3. i*: NW06, PR09, SD17, SD32.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_12</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P07" name="Producers settled">
      <bpmn:incoming>Flow_BRF_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P02" name="Verify organic certification">
      <bpmn:documentation>P02. Owner: F04 Quality and traceability. Open question T3 in processes.md. See requirements/strategic/processes.md, section 3. i*: SD25.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_14</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CertificationVerified" name="Certification verified?" default="Flow_BRF_30">
      <bpmn:documentation>R02. Where certification is claimed, the listing is published only if the verification succeeds. See requirements/strategic/interactions.md, section 4.2.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_15</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_BRF_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ListingNotPublished" name="Listing not published">
      <bpmn:incoming>Flow_BRF_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P08" name="Quality concern received">
      <bpmn:outgoing>Flow_BRF_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P08" messageRef="Message_QualityConcern" />
    </bpmn:startEvent>
    <bpmn:task id="P08" name="Handle quality incident">
      <bpmn:documentation>P08. Owner: F04 Quality and traceability. Roles A06 and A07 work here (Use Case 3). See requirements/strategic/processes.md, section 3. i*: NW07.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_16</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P08" name="Incident closed">
      <bpmn:incoming>Flow_BRF_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P09" name="Postcode received">
      <bpmn:outgoing>Flow_BRF_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P09" messageRef="Message_Postcode" />
    </bpmn:startEvent>
    <bpmn:task id="P09" name="Report food miles">
      <bpmn:documentation>P09. Owner: F05. See requirements/strategic/processes.md, section 3. i*: SD26, SD40.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_18</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P09" name="Food miles shown">
      <bpmn:incoming>Flow_BRF_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P10" name="Surplus produce reported">
      <bpmn:outgoing>Flow_BRF_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P10" messageRef="Message_SurplusReported" />
    </bpmn:startEvent>
    <bpmn:task id="P10" name="Offer surplus produce">
      <bpmn:documentation>P10. Owner: F05. See requirements/strategic/processes.md, section 3. i*: SD38.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_20</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P10" name="Surplus offer published">
      <bpmn:incoming>Flow_BRF_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P11" name="Content submitted">
      <bpmn:outgoing>Flow_BRF_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P11" messageRef="Message_ContentSubmitted" />
    </bpmn:startEvent>
    <bpmn:task id="P11" name="Share educational content">
      <bpmn:documentation>P11. Owner: F05. See requirements/strategic/processes.md, section 3. i*: SD39.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_22</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P11" name="Content published">
      <bpmn:incoming>Flow_BRF_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_PaymentSucceeded" name="Payment successful?" default="Flow_BRF_04">
      <bpmn:documentation>i*: MP22.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_BRF_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_PaymentNotCompleted" name="Payment not completed">
      <bpmn:documentation>The payment failed after the retries in P05. The operational model of P05 shows the decline, retry and service unavailable paths. i*: MP24.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_P12" name="Order issue reported">
      <bpmn:documentation>M24. A customer reports a late or missing delivery, wrong or damaged goods, or asks for a refund after the order is confirmed (design decision D8).</bpmn:documentation>
      <bpmn:outgoing>Flow_BRF_34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P12" messageRef="Message_OrderIssue" />
    </bpmn:startEvent>
    <bpmn:task id="P12" name="Handle order issue">
      <bpmn:documentation>P12. Owner: F02 Order management. Group design decision D8 (interactions.md, section 8): the sources cover cancellation before payment and food safety concerns only. F02 owns the case, checks the order records of P04 (R18) and decides; the producer is contacted through E03 and F03 refunds through E01 (R19). Those exchanges belong to the operational model; Figure 1 shows the customer exchange (M24, M25). See requirements/strategic/processes.md, section 3. i*: CU18, SD41, NW15, MP33.</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_34</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P12" name="Issue resolved">
      <bpmn:documentation>A redelivery or collection is arranged with the producer, or the customer is refunded, and the customer is told (M25).</bpmn:documentation>
      <bpmn:incoming>Flow_BRF_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="P04" name="Process order">
      <bpmn:documentation>P04. Owner: F02 Order management. Stock check, delivery or collection, order split by producer (Use Case 2). See requirements/strategic/processes.md, section 3. i*: SD01, MP03, MP05, SD12, SD13.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="process_order" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BRF_31</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_03</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P05" name="Process payment">
      <bpmn:documentation>P05. Owner: F03 Finance and settlements. Sandbox payment, decline and retry, service unavailable path, 5% commission (Use Case 2). On success it confirms the order (M07), F01 updates the stock (R07) and F02 asks E03 to notify the producers (M08, M09, R08); see processes.md, section 4. See requirements/strategic/processes.md, section 3. i*: MP04, MP15, MP16, MP17, MP18, MP19, SD19.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="process_payment" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BRF_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BRF_05</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_BRF_34" sourceRef="Start_P12" targetRef="P12" />
    <bpmn:sequenceFlow id="Flow_BRF_35" sourceRef="P12" targetRef="End_P12" />
    <bpmn:sequenceFlow id="Flow_BRF_01" sourceRef="Start_UC2" targetRef="P03" />
    <bpmn:sequenceFlow id="Flow_BRF_31" name="Yes" sourceRef="Gateway_ItemsInStock" targetRef="P04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=itemsInStock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BRF_32" name="No" sourceRef="Gateway_ItemsInStock" targetRef="Event_AmendOrder" />
    <bpmn:sequenceFlow id="Flow_BRF_33" sourceRef="Event_AmendOrder" targetRef="P03" />
    <bpmn:sequenceFlow id="Flow_BRF_02" sourceRef="P03" targetRef="Gateway_ItemsInStock" />
    <bpmn:sequenceFlow id="Flow_BRF_10" sourceRef="Start_P01" targetRef="P01" />
    <bpmn:sequenceFlow id="Flow_BRF_11" sourceRef="P01" targetRef="Gateway_OrganicClaim" />
    <bpmn:sequenceFlow id="Flow_BRF_14" name="Yes" sourceRef="Gateway_OrganicClaim" targetRef="P02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=organicCertificationClaimed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BRF_27" name="No" sourceRef="Gateway_OrganicClaim" targetRef="End_P01" />
    <bpmn:sequenceFlow id="Flow_BRF_29" name="Yes" sourceRef="Gateway_CertificationVerified" targetRef="End_P01">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=certificationVerified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BRF_12" sourceRef="Start_P07" targetRef="P07" />
    <bpmn:sequenceFlow id="Flow_BRF_13" sourceRef="P07" targetRef="End_P07" />
    <bpmn:sequenceFlow id="Flow_BRF_15" sourceRef="P02" targetRef="Gateway_CertificationVerified" />
    <bpmn:sequenceFlow id="Flow_BRF_30" name="No" sourceRef="Gateway_CertificationVerified" targetRef="End_ListingNotPublished" />
    <bpmn:sequenceFlow id="Flow_BRF_16" sourceRef="Start_P08" targetRef="P08" />
    <bpmn:sequenceFlow id="Flow_BRF_17" sourceRef="P08" targetRef="End_P08" />
    <bpmn:sequenceFlow id="Flow_BRF_18" sourceRef="Start_P09" targetRef="P09" />
    <bpmn:sequenceFlow id="Flow_BRF_19" sourceRef="P09" targetRef="End_P09" />
    <bpmn:sequenceFlow id="Flow_BRF_20" sourceRef="Start_P10" targetRef="P10" />
    <bpmn:sequenceFlow id="Flow_BRF_21" sourceRef="P10" targetRef="End_P10" />
    <bpmn:sequenceFlow id="Flow_BRF_22" sourceRef="Start_P11" targetRef="P11" />
    <bpmn:sequenceFlow id="Flow_BRF_23" sourceRef="P11" targetRef="End_P11" />
    <bpmn:sequenceFlow id="Flow_BRF_05" sourceRef="P05" targetRef="Gateway_PaymentSucceeded" />
    <bpmn:sequenceFlow id="Flow_BRF_06" name="Yes" sourceRef="Gateway_PaymentSucceeded" targetRef="End_UC2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentSucceeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BRF_04" name="No" sourceRef="Gateway_PaymentSucceeded" targetRef="End_PaymentNotCompleted" />
    <bpmn:sequenceFlow id="Flow_BRF_03" sourceRef="P04" targetRef="P05" />
    <bpmn:textAnnotation id="Annotation_P07">
      <bpmn:text>Weekly, less the 5% commission, with an audit trail for tax reporting (CS p. 2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P07" sourceRef="Annotation_P07" targetRef="P07" />
    <bpmn:textAnnotation id="Annotation_P05">
      <bpmn:text>Single and multi-vendor payments; the 5% commission is calculated here (CS p. 2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P05" sourceRef="Annotation_P05" targetRef="P05" />
    <bpmn:textAnnotation id="Annotation_P09">
      <bpmn:text>Postcode distance from farm to delivery or collection point; shown in P03 and P04 (R13, R14)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P09" sourceRef="Annotation_P09" targetRef="P09" />
    <bpmn:textAnnotation id="Annotation_P08">
      <bpmn:text>Uses the order records of P04 to find who is affected (R10); may suspend the listing in P01 (R11)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P08" sourceRef="Annotation_P08" targetRef="P08" />
    <bpmn:textAnnotation id="Annotation_P11">
      <bpmn:text>Published next to the producer&#39;s products in P03 (R16)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P11" sourceRef="Annotation_P11" targetRef="P11" />
    <bpmn:textAnnotation id="Annotation_P10">
      <bpmn:text>Discount applied to the order in P04 (R15)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P10" sourceRef="Annotation_P10" targetRef="P10" />
    <bpmn:textAnnotation id="Annotation_P12">
      <bpmn:text>Delivery problems and refund requests after the order (design decision D8). The refund through E01 and the producer contact belong to the operational model</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P12" sourceRef="Annotation_P12" targetRef="P12" />
  </bpmn:process>
  <bpmn:process id="Process_Producer" name="Producer" isExecutable="false">
    <bpmn:startEvent id="Start_P06" name="Producer order received">
      <bpmn:outgoing>Flow_Producer_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_P06" messageRef="Message_ProducerOrder" />
    </bpmn:startEvent>
    <bpmn:task id="P06" name="Fulfil order">
      <bpmn:documentation>P06. Owner: the producer (A04). Prepares the goods for the agreed delivery or collection. Producers require visibility of incoming orders with at least 48 hours' lead time for preparation. See requirements/strategic/processes.md, section 3. i*: PR07, SD10, CU12.</bpmn:documentation>
      <bpmn:incoming>Flow_Producer_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Producer_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P06" name="Goods delivered or collected">
      <bpmn:incoming>Flow_Producer_02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Producer_01" sourceRef="Start_P06" targetRef="P06" />
    <bpmn:sequenceFlow id="Flow_Producer_02" sourceRef="P06" targetRef="End_P06" />
    <bpmn:textAnnotation id="Annotation_P06">
      <bpmn:text>Orders visible to the producer at least 48 hours before preparation (CS p. 2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_P06" sourceRef="Annotation_P06" targetRef="P06" />
  </bpmn:process>
