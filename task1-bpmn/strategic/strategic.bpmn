        <dc:Bounds x="530" y="460" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateStock_di" bpmnElement="Task_UpdateStock">
        <dc:Bounds x="1010" y="200" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyProducers_di" bpmnElement="Task_NotifyProducers">
        <dc:Bounds x="1190" y="460" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_UC2_di" bpmnElement="End_UC2">
        <dc:Bounds x="1402" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P01_di" bpmnElement="Start_P01">
        <dc:Bounds x="242" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
