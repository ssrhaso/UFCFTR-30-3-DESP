        <dc:Bounds x="190" y="580" width="1610" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_F02_di" bpmnElement="Lane_F02" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1610" height="160" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
