        <dc:Bounds x="1442" y="662" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_di" bpmnElement="P07">
        <dc:Bounds x="1530" y="640" width="140" height="80" />
