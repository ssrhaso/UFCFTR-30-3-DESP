    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BRF_27" name="No" sourceRef="Gateway_OrganicClaim" targetRef="End_P01" />
    <bpmn:sequenceFlow id="Flow_BRF_29" name="Yes" sourceRef="Gateway_CertificationVerified" targetRef="End_P01">
