        <dc:Bounds x="190" y="180" width="1610" height="240" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_UC2_di" bpmnElement="Start_UC2">
        <dc:Bounds x="242" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_di" bpmnElement="P03">
