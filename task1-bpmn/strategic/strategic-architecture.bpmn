<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_strategic" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_strategic">
    <bpmn:participant id="Participant_actor" name="Actor (e.g. Customer)" processRef="Process_actor" />
    <bpmn:participant id="Participant_systemA" name="System A (e.g. Web App)" processRef="Process_systemA" />
    <bpmn:participant id="Participant_systemB" name="System B (e.g. Backend Service)" processRef="Process_systemB" />
    <bpmn:messageFlow id="MessageFlow_1" name="request" sourceRef="Task_actor" targetRef="Task_systemA" />
    <bpmn:messageFlow id="MessageFlow_2" name="forward" sourceRef="Task_systemA" targetRef="Task_systemB" />
  </bpmn:collaboration>
  <bpmn:process id="Process_actor" name="Actor" isExecutable="false">
    <bpmn:startEvent id="Start_actor" name="Need arises">
      <bpmn:outgoing>Flow_a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_actor" name="Make a request">
      <bpmn:incoming>Flow_a1</bpmn:incoming>
      <bpmn:outgoing>Flow_a2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_actor" name="Done">
      <bpmn:incoming>Flow_a2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a1" sourceRef="Start_actor" targetRef="Task_actor" />
    <bpmn:sequenceFlow id="Flow_a2" sourceRef="Task_actor" targetRef="End_actor" />
  </bpmn:process>
  <bpmn:process id="Process_systemA" name="System A" isExecutable="false">
    <bpmn:startEvent id="Start_systemA" name="Request received">
      <bpmn:outgoing>Flow_b1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_systemA" name="Handle request">
      <bpmn:incoming>Flow_b1</bpmn:incoming>
      <bpmn:outgoing>Flow_b2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_systemA" name="Handled">
      <bpmn:incoming>Flow_b2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b1" sourceRef="Start_systemA" targetRef="Task_systemA" />
    <bpmn:sequenceFlow id="Flow_b2" sourceRef="Task_systemA" targetRef="End_systemA" />
  </bpmn:process>
  <bpmn:process id="Process_systemB" name="System B" isExecutable="false">
    <bpmn:startEvent id="Start_systemB" name="Work received">
      <bpmn:outgoing>Flow_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_systemB" name="Process work">
      <bpmn:incoming>Flow_c1</bpmn:incoming>
      <bpmn:outgoing>Flow_c2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_systemB" name="Processed">
      <bpmn:incoming>Flow_c2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c1" sourceRef="Start_systemB" targetRef="Task_systemB" />
    <bpmn:sequenceFlow id="Flow_c2" sourceRef="Task_systemB" targetRef="End_systemB" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_strategic">
      <bpmndi:BPMNShape id="Participant_actor_di" bpmnElement="Participant_actor" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_actor_di" bpmnElement="Start_actor">
        <dc:Bounds x="232" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="219" y="180" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_actor_di" bpmnElement="Task_actor">
        <dc:Bounds x="320" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_actor_di" bpmnElement="End_actor">
        <dc:Bounds x="492" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="498" y="180" width="25" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_a1_di" bpmnElement="Flow_a1">
        <di:waypoint x="268" y="155" /><di:waypoint x="320" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a2_di" bpmnElement="Flow_a2">
        <di:waypoint x="420" y="155" /><di:waypoint x="492" y="155" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_systemA_di" bpmnElement="Participant_systemA" isHorizontal="true">
        <dc:Bounds x="160" y="260" width="600" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_systemA_di" bpmnElement="Start_systemA">
        <dc:Bounds x="232" y="317" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="208" y="360" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_systemA_di" bpmnElement="Task_systemA">
        <dc:Bounds x="320" y="295" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_systemA_di" bpmnElement="End_systemA">
        <dc:Bounds x="492" y="317" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="488" y="360" width="44" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_b1_di" bpmnElement="Flow_b1">
        <di:waypoint x="268" y="335" /><di:waypoint x="320" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_b2_di" bpmnElement="Flow_b2">
        <di:waypoint x="420" y="335" /><di:waypoint x="492" y="335" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_systemB_di" bpmnElement="Participant_systemB" isHorizontal="true">
        <dc:Bounds x="160" y="440" width="600" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_systemB_di" bpmnElement="Start_systemB">
        <dc:Bounds x="232" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="212" y="540" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_systemB_di" bpmnElement="Task_systemB">
        <dc:Bounds x="320" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_systemB_di" bpmnElement="End_systemB">
        <dc:Bounds x="492" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="485" y="540" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_c1_di" bpmnElement="Flow_c1">
        <di:waypoint x="268" y="515" /><di:waypoint x="320" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_di" bpmnElement="Flow_c2">
        <di:waypoint x="420" y="515" /><di:waypoint x="492" y="515" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="370" y="195" /><di:waypoint x="370" y="295" />
        <bpmndi:BPMNLabel><dc:Bounds x="376" y="238" width="32" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="370" y="375" /><di:waypoint x="370" y="475" />
        <bpmndi:BPMNLabel><dc:Bounds x="376" y="418" width="39" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
