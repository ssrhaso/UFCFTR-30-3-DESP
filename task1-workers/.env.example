# Copy this file to .env and fill in the values. Do not commit .env.

# Camunda 8 SaaS: Console > Clusters > (the module cluster) > API > Create new client, scope "Zeebe".
# Paste the values that Console shows for the client (the cluster runs Camunda 8.9).
# Console can call the address ZEEBE_GRPC_ADDRESS. Either name works.
ZEEBE_ADDRESS=
ZEEBE_CLIENT_ID=
ZEEBE_CLIENT_SECRET=
ZEEBE_AUTHORIZATION_SERVER_URL=https://login.cloud.camunda.io/oauth/token
ZEEBE_TOKEN_AUDIENCE=zeebe.camunda.io

# Local Camunda 8 Run instead of SaaS: set ZEEBE_LOCAL=1 and ZEEBE_ADDRESS=localhost:26500
ZEEBE_LOCAL=0

# The Tasklist user who plays the customer (your Camunda login).
# process_payment assigns its two user tasks to this user.
CUSTOMER_ID=

# Mock switches. 1 = on.
MOCK_STOCK_SERVICE_DOWN=0
MOCK_PAYMENT_SERVICE_DOWN=0
MOCK_STOCK_UPDATE_FAILS=0
# A producer id (for example PR-02): the notification to this producer fails
MOCK_FAIL_NOTIFY_PRODUCER=

# Timing of the mocks
HOLD_MINUTES=15
REMINDER_MINUTES_BEFORE=5
PAYMENT_ANSWER_DELAY_SECONDS=3
